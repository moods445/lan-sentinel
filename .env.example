# ===== 控制面 =====
SENTINEL_LISTEN=:8110
# 独立库 sentinel + 最小权限角色；Unraid 上不要用 root
PG_DSN=postgres://sentinel_app:change-me@192.168.1.102:5432/sentinel?sslmode=disable&pool_max_conns=8

# 面板访问令牌；留空 = 局域网内免登录（仅样例）
PANEL_TOKEN=
# 所有 Agent 共用令牌；配了单机 token_hash 时以单机为准
AGENT_TOKEN=change-me-agent-token
# 面板「添加节点」生成的一键安装脚本地址（默认 GitHub raw）
# SENTINEL_INSTALL_URL=https://raw.githubusercontent.com/moods445/lan-sentinel/master/install.sh

# 镜像来自 GHCR（禁止本地构建）；固定版本写成 ghcr.io/moods445/lan-sentinel:v0.2.1
SENTINEL_IMAGE=ghcr.io/moods445/lan-sentinel:latest
SENTINEL_AGENT_IMAGE=ghcr.io/moods445/lan-sentinel-agent:latest
LOG_LEVEL=info
TZ=Asia/Shanghai
